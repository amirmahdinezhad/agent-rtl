{
  "name": "rasta",
  "version": "1.0.4",
  "description": "Rasta adds right-to-left (RTL) text, Persian and Arabic reading controls, fonts and themes to Codex and T3 Code on macOS.",
  "type": "module",
  "bin": {
    "rasta": "./bin/index.js"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:language": "node --test test/language-policy.test.js",
    "test:codex-browser": "node test/codex-browser-smoke.mjs",
    "test:codex-content": "node test/codex-content-smoke.mjs",
    "test:message-directions": "node test/message-directions-smoke.mjs",
    "test:codex-native": "node test/codex-native-smoke.mjs",
    "test:gui": "node test/gui-electron-smoke.mjs && node test/font-electron-smoke.mjs",
    "test:installer": "node test/gui-job-smoke.mjs",
    "test:events": "node test/update-event-smoke.mjs",
    "test:design": "node test/ui-design-smoke.mjs",
    "test:fonts": "node test/font-controls-smoke.mjs",
    "preview:design": "node tools/preview-design.mjs",
    "build:gui": "node tools/build-gui.mjs",
    "release:manifest": "node tools/release-manifest.mjs",
    "test:t3-design": "node test/t3-design-smoke.mjs",
    "clean": "node tools/clean.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "rasta",
    "codex",
    "t3-code",
    "t3code",
    "rtl",
    "right-to-left",
    "persian",
    "farsi",
    "arabic",
    "hebrew",
    "macos",
    "typography"
  ],
  "license": "MIT",
  "files": [
    "bin",
    "docs",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "fast-xml-parser": "^5.11.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "electron": "42.11.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirmahdinezhad/rasta.git"
  },
  "homepage": "https://github.com/amirmahdinezhad/rasta#readme",
  "bugs": {
    "url": "https://github.com/amirmahdinezhad/rasta/issues"
  }
}
